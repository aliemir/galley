<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated keys (GENERATE_INFOPLIST_FILE). Kept outside
	     app/Galley/ so the synchronized group does not bundle it as well. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<!-- Markdown: Galley reads it and never writes it. Alternate, so it
		     offers itself in Open With without taking over the default. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
			</array>
		</dict>
		<!-- Folders, so one dropped on the Dock icon opens as a workspace.
		     Rank None: never offered as a folder's default app. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<!-- The system declares Markdown on recent macOS; importing it as well
	     covers every extension the scanner reads. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.daringfireball.markdown</string>
			<key>UTTypeDescription</key>
			<string>Markdown Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>md</string>
					<string>markdown</string>
					<string>mdown</string>
					<string>mkd</string>
					<string>mkdn</string>
					<string>mdtext</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/markdown</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Sparkle: the feed attached to the newest GitHub release, and the
	     public half of the key tools/release.sh signs each DMG with. -->
	<key>SUFeedURL</key>
	<string>https://github.com/aliemir/galley/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>euqPYHB1smpK1vmfWE2qRPSyHwIBkQ5x2DzYKYxyTfE=</string>
</dict>
</plist>
