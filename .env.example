# App Store Connect API key.
# The .p8 lives outside the repo, in the directory altool searches by convention:
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8   (chmod 600)
# With it there, `xcrun altool --api-key $APP_STORE_CONNECT_KEY_ID` finds it
# with no path. KEY_PATH is for tools that want one explicitly (notarytool -k,
# xcodebuild -authenticationKeyPath).
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_${APP_STORE_CONNECT_KEY_ID}.p8"

