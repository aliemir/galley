# What tools/release.sh needs to notarize. Copy to .env (git-ignored).
# The App Store Connect API key signs notarytool in; the .p8 lives outside
# the repo, at ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 (chmod 600).
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_${APP_STORE_CONNECT_KEY_ID}.p8"

# Your Apple Developer team, for Developer ID signing.
APPLE_TEAM_ID=
